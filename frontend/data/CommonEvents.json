      { "code": 401, "indent": 0, "parameters": ["leve."] },
      { "code": 101, "indent": 0, "parameters": ["", 0, 0, 2, ""] },
      { "code": 401, "indent": 0, "parameters": ["Pedralúmen: Minério de coloração azul, usado na fortificação"] },
      { "code": 401, "indent": 0, "parameters": ["de estruturas e constructos."] },
      { "code": 101, "indent": 0, "parameters": ["", 0, 0, 2, ""] },
      { "code": 401, "indent": 0, "parameters": ["Jade: Minério de cor verde, utilizado na confecção de"] },
