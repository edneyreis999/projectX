        "parameters": ["", 0, 0, 2, ""]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["Tarlinihos: Minério de coloração vermelha, usado para "]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["forja de armaduras e escudos. É resistente, porém também"]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["leve."]
      },
      {
        "code": 101,
        "indent": 0,
        "parameters": ["", 0, 0, 2, ""]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["Pedralúmen: Minério de coloração azul, usado na fortificação"]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["de estruturas e constructos."]
      },
      {
        "code": 101,
        "indent": 0,
        "parameters": ["", 0, 0, 2, ""]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["Jade: Minério de cor verde, utilizado na confecção de"]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["jóias e estruturas luxuosas personalizadas."]
      },
      {
        "code": 101,
        "indent": 0,
        "parameters": ["", 0, 0, 2, ""]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["Kraven: Minério de cor amarela, utilizado para a cunhagem"]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["da moeda de Kraven, símbolo do império dos anões."]
      },
      {
        "code": 101,
        "indent": 0,
        "parameters": ["", 0, 0, 2, ""]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["Sigmetal: Minério de cor lilás. Extremamente raro, "]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["utilizado na forja de armas e ferramentas científicas. Um"]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["único exemplar vale algumas fortunas."]
      },
      {
        "code": 101,
        "indent": 0,
        "parameters": ["", 0, 0, 2, ""]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["Todos os minérios ficam dentro de carapaças feitas "]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["de pedras comuns que não tem serventia alguma. O jeito "]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["mais simples e eficaz de minerar é bater com uma picareta "]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["reforçada em fluxo constante e força moderada. "]
      },
      {
        "code": 101,
        "indent": 0,
        "parameters": ["", 0, 0, 2, ""]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["Assim que notar a primeira rachadura, retire um pedaço da "]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["carapaça de pedra e observe, procure por brilhos coloridos e"]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": ["outros sinais dos minérios. Passe para a próxima pedra"]
      },
      {
        "code": 401,
        "indent": 0,
        "parameters": [" caso não haja nenhum."]
      },
      {
        "code": 0,
        "indent": 0,
        "parameters": []
      }
    ],
    "name": "Guia das Pedras e Minérios para Idiotas",
    "switchId": 1,
    "trigger": 0
