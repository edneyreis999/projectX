        <nsd:description>Jogador escolhe digitar nome próprio ao invés de usar padrão</nsd:description>
        <nsd:steps>
          <nsd:step sequence="1">Completar até Rheed perguntar nome</nsd:step>
          <nsd:step sequence="2">Escolher "Digitar nome..."</nsd:step>
          <nsd:step sequence="3">Digitar nome customizado</nsd:step>
          <nsd:step sequence="4">Continuar fluxo normal</nsd:step>
        </nsd:steps>
        <nsd:expectedResults>
          <nsd:result>v_qNoite_playerName = 1</nsd:result>
          <nsd:result>Nome do Actor 1 atualizado corretamente</nsd:result>
        </nsd:expectedResults>
      </nsd:scenario>

      <nsd:scenario name="Crianças Posicionam Após 5 Passos" type="edge_case">
        <nsd:description>Verificar que crianças mudam comportamento após 5 passos</nsd:description>
        <nsd:steps>
          <nsd:step sequence="1">Spawn e dar 5 passos</nsd:step>
        </nsd:steps>
        <nsd:expectedResults>
          <nsd:result>v_qNoite_stepCount >= 5</nsd:result>
          <nsd:result>Crianças mudam de movimento aleatório para posições fixas</nsd:result>
        </nsd:expectedResults>
      </nsd:scenario>

      <nsd:scenario name="Save/Load Durante Quest" type="edge_case">
        <nsd:description>Salvar e carregar em diferentes pontos da quest</nsd:description>
        <nsd:steps>
          <nsd:step sequence="1">Salvar após falar com Darla (v_qNoite_progress = 1)</nsd:step>
          <nsd:step sequence="2">Carregar save</nsd:step>
          <nsd:step sequence="3">Verificar que brilho ainda está visível</nsd:step>
        </nsd:steps>
        <nsd:expectedResults>
          <nsd:result>Jogador reposicionado corretamente</nsd:result>
          <nsd:result>Estado da quest restaurado corretamente</nsd:result>
        </nsd:expectedResults>
      </nsd:scenario>

      <nsd:scenario name="Regressão - Eventos Pré-existentes" type="regression">
        <nsd:description>Garantir que eventos pré-existentes do mapa ainda funcionam</nsd:description>
        <nsd:steps>
