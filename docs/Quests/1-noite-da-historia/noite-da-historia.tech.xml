            <nsd:commandLine>Control Switches: [055] s_qNoite_rheedInteraction = ON</nsd:commandLine>
            <nsd:commandLine>Control Variables: [026] v_qNoite_progress = 2</nsd:commandLine>
            <nsd:commandLine>Set Move Route: Player (Wait: ON)</nsd:commandLine>
            <nsd:commandLine>Show Text: Rheed: "Olha quem chegou atrasado!"</nsd:commandLine>
            <nsd:commandLine>Set Move Route: Rheed (move to player)</nsd:commandLine>
            <nsd:commandLine>Wait: 60 frames</nsd:commandLine>
            <nsd:commandLine>Show Text: Rheed: "E qual é o seu nome, pequeno?"</nsd:commandLine>
            <nsd:commandLine>Show Choices: "Dulgarin" / "Digitar nome..."</nsd:commandLine>
            <nsd:commandLine>When [Dulgarin]</nsd:commandLine>
            <nsd:commandLine>  Control Variables: [041] v_qNoite_playerName = 0</nsd:commandLine>
            <nsd:commandLine>When [Digitar nome...]</nsd:commandLine>
            <nsd:commandLine>  Input Name: Actor 1 (max 10 chars)</nsd:commandLine>
            <nsd:commandLine>  Control Variables: [041] v_qNoite_playerName = 1</nsd:commandLine>
            <nsd:commandLine>Show Text: Rheed: "Muito prazer, [nome do jogador]!"</nsd:commandLine>
            <nsd:commandLine>Control Variables: [026] v_qNoite_progress = 3</nsd:commandLine>
            <nsd:commandLine>Set Move Route: Rheed (move back to center)</nsd:commandLine>
            <nsd:commandLine>Wait: 60 frames</nsd:commandLine>
            <nsd:commandLine>Set Move Route: Rheed (turn toward audience)</nsd:commandLine>
          </nsd:commands>
