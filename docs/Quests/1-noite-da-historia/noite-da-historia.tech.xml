        <nsd:description>Jogador completa a quest do início ao fim sem desvios</nsd:description>
        <nsd:steps>
          <nsd:step sequence="1">Iniciar jogo - spawn do jogador</nsd:step>
          <nsd:step sequence="2">Pan de câmera até Darla</nsd:step>
          <nsd:step sequence="3">Movimentar até Darla e falar</nsd:step>
