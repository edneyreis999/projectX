          <nsd:result>Todos os switches 52-56 desligados ao final</nsd:result>
          <nsd:result>Jogador controla Thorin em Gildrat</nsd:result>
          <nsd:result>Sem erros de execução</nsd:result>
        </nsd:expectedResults>
      </nsd:scenario>

