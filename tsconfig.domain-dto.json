{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleDetection": "auto",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmitOnError": true,
    "allowJs": true,
    "rootDir": "frontend/js",
    "outDir": "frontend/js"
  },
  "include": [
    "frontend/js/domain/**/*.ts",
    "frontend/js/dto/**/*.ts",
    "frontend/js/dto/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend/js/plugins",
    "frontend/js/application"
  ]
}
