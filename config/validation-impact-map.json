{
  "schemaVersion": "validation-impact-map/v2",
  "questManifestsRoot": "docs/Quests",
  "checks": [
    {
      "id": "harness",
      "command": "npm",
      "args": ["run", "test:harness"]
    },
    {
      "id": "noite-da-historia",
      "command": "npm",
      "args": ["run", "test:noite-da-historia"]
    },
    {
      "id": "rpg-maker-data",
      "command": "npm",
      "args": ["run", "test:rpg-maker-data"]
    },
    {
      "id": "build-types",
      "command": "npm",
      "args": ["run", "build:types"]
    }
  ],
  "rules": [
    {
      "id": "harness-infrastructure",
      "targets": [
        "config/validation-impact-map.json",
        "scripts/validation-impact.js",
        "scripts/validate-staged.js",
        ".github/workflows/authoring-integrity.yml",
        ".gitignore",
        "AGENTS.md",
        "frontend/__tests__/harness/**",
        "docs/architecture/validation-impact-map.md",
        "docs/project-conventions/rpg-maker-event-lifecycle.md"
      ],
      "checks": ["harness"]
    },
    {
      "id": "authoring-authority-conventions",
      "targets": ["docs/project-conventions/authoring-materialization-authority.md", "docs/project-conventions/validation-evidence-lifecycle.md"],
      "checks": ["harness", "semifinal-integrity"]
    },
    {
      "id": "shared-event-lifecycle-harness",
      "targets": ["frontend/test-support/rpg-maker-event-lifecycle.js"],
      "checks": ["harness", "noite-da-historia", "semifinal-tests"]
    },
    {
      "id": "rpg-maker-data-structure",
      "targets": ["frontend/data/*.json", "frontend/__tests__/data/rpg-maker-data-integrity.test.js"],
      "checks": ["rpg-maker-data"]
    },
    {
      "id": "shared-quest-test-surface",
      "targets": ["frontend/__tests__/quests/**"],
      "checks": ["noite-da-historia", "semifinal-tests"]
    },
    {
      "id": "noite-da-historia-contracts",
      "targets": ["docs/Quests/1-noite-da-historia/**"],
      "checks": ["noite-da-historia"]
    },
    {
      "id": "shared-quest-runtime",
      "targets": ["frontend/data/CoretoQuests.json", "frontend/js/plugins/Coreto_QuestCore.js", "frontend/js/plugins/Coreto_QuestVN.js"],
      "checks": ["noite-da-historia", "semifinal-integrity", "semifinal-tests", "build-types"]
    },
    {
      "id": "shared-cutscene-runtime",
      "targets": ["frontend/js/plugins/Coreto_Cutscene.js"],
      "checks": ["semifinal-tests", "build-types"]
    },
    {
      "id": "package-validation-surface",
      "targets": ["package.json", "package-lock.json", "jest.config.ts", ".nvmrc"],
      "checks": ["harness", "rpg-maker-data", "noite-da-historia", "semifinal-integrity", "semifinal-tests", "build-types"]
    }
  ],
  "protectedTargets": [
    "config/validation-impact-map.json",
    "scripts/validation-impact.js",
    "scripts/validate-staged.js",
    ".github/workflows/authoring-integrity.yml",
    ".gitignore",
    "AGENTS.md",
    "frontend/test-support/rpg-maker-event-lifecycle.js",
    "frontend/__tests__/harness/**",
    "frontend/__tests__/quests/**",
    "frontend/__tests__/data/rpg-maker-data-integrity.test.js",
    "frontend/data/*.json",
    "docs/architecture/validation-impact-map.md",
    "docs/project-conventions/authoring-materialization-authority.md",
    "docs/project-conventions/validation-evidence-lifecycle.md",
    "docs/project-conventions/rpg-maker-event-lifecycle.md",
    "package.json",
    "package-lock.json",
    "jest.config.ts",
    ".nvmrc"
  ]
}
