{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "strict": true,
    "esModuleInterop": false,
    "moduleDetection": "legacy",
    "allowJs": true,
    "noEmitOnError": true,
    "rootDir": "frontend/js",
    "outDir": "frontend/js",
    "skipLibCheck": true,
    "declaration": true
  },
  "include": [
    "frontend/js/application/**/*.ts",
    "frontend/js/dto/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
